rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with your app's URL can read and add charts.
    // This is fine for a private link shared between you and a friend,
    // but do NOT post the URL publicly.
    match /charts/{chartId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
